{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build AVR firmware",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean AVR firmware",
      "type": "shell",
      "command": "make clean"
    },
    {
      "label": "Program AVRISP application",
      "type": "shell",
      "command": "make program",
      "problemMatcher": []
    },
    {
      "label": "Initialize AVR board",
      "type": "shell",
      "command": "make init",
      "problemMatcher": []
    }
  ]
}
